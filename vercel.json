{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/solucoes/comercial",
      "destination": "/solucoes/vendas",
      "permanent": true
    },
    {
      "source": "/solucoes/inteligencia-artificial",
      "destination": "/solucoes/prisma",
      "permanent": true
    },
    {
      "source": "/solucoes/estudio",
      "destination": "/solucoes/fqd-studios",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
