{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/solucoes/comercial", "destination": "/solucoes/vendas", "permanent": true },
    { "source": "/solucoes/estudio", "destination": "/solucoes/fqd-studios", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
